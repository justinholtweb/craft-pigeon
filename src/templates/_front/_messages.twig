{# Renders a conversation. Expects: messages (MessageRecord[]), currentUserId (int|null), and token (string|null) for a guest — attachment links carry it. #}
{% for message in messages %}
    {% set isMine = currentUserId is defined and currentUserId and message.authorUserId == currentUserId %}
    <div class="pg-msg{{ isMine ? ' pg-mine' : '' }}">
        <div class="pg-meta">
            <strong>{{ message.authorName ?: (message.authorEmail ?: 'Someone'|t('pigeon')) }}</strong>
            · {{ message.dateCreated|datetime('short') }}
        </div>
        <div class="pg-body">{{ message.body|nl2br }}</div>
        {% set attachments = message.attachments %}
        {% if attachments|length %}
            <ul>
                {% for att in attachments %}
                    <li>
                        {% if att.asset %}
                            {# Through Pigeon's checked download, never the asset's own URL: on a public volume that is a public file. #}
                            {% set params = { id: att.id }|merge((token ?? null) ? { access: token } : {}) %}
                            <a href="{{ actionUrl('pigeon/attachments/download', params) }}">{{ att.filename ?: att.asset.filename }}</a>
                        {% else %}
                            {{ att.filename ?: 'Attachment'|t('pigeon') }}
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>
{% else %}
    <p>{{ 'No messages yet.'|t('pigeon') }}</p>
{% endfor %}
