{
    "name": "justinholtweb/pigeon",
    "description": "Two-way threaded messaging for Craft CMS 5 — customer support inboxes and user-to-user conversations with email, control panel, and on-site notifications.",
    "type": "craft-plugin",
    "version": "5.1.0",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "craft-plugin",
        "pigeon",
        "messaging",
        "support",
        "inbox",
        "notifications"
    ],
    "license": "proprietary",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Justin Holt",
            "homepage": "https://justinholt.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "craftcms/cms": "^5.4.0"
    },
    "require-dev": {
        "codeception/codeception": "^5.2.0",
        "codeception/module-asserts": "^3.0.0",
        "codeception/module-datafactory": "^3.0.0",
        "codeception/module-yii2": "^1.1.9",
        "craftcms/ecs": "dev-main",
        "craftcms/phpstan": "dev-main",
        "fakerphp/faker": "^1.19.0",
        "league/factory-muffin": "^3.3.0",
        "phpstan/phpstan": "^1.12 || ^2.2",
        "vlucas/phpdotenv": "^5.4.1"
    },
    "autoload": {
        "psr-4": {
            "justinholtweb\\pigeon\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "justinholtweb\\pigeontests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "yiisoft/yii2-composer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "phpstan": "phpstan analyse --memory-limit=1G",
        "ecs-check": "ecs check --ansi",
        "ecs-fix": "ecs check --fix --ansi",
        "test": "codecept run unit",
        "test-build": "codecept build"
    },
    "support": {
        "issues": "https://github.com/justinholtweb/craft-pigeon/issues",
        "source": "https://github.com/justinholtweb/craft-pigeon"
    },
    "extra": {
        "name": "Pigeon",
        "handle": "pigeon",
        "developer": "Justin Holt",
        "developerUrl": "https://justinholt.com",
        "documentationUrl": "https://craft-pigeon.com/docs",
        "changelogUrl": "https://raw.githubusercontent.com/justinholtweb/craft-pigeon/main/CHANGELOG.md",
        "class": "justinholtweb\\pigeon\\Plugin"
    }
}
